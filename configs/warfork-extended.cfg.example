// warfork-extended — paste relevant lines into your server.cfg
// Do NOT exec this file from the gametype; admins own server.cfg.
// Docs: README.md (Operators / Optional features / Server config)

// Master switch (1 = enable framework hooks / features)
set we_enabled "1"

// Extra G_Print on GT_* wrappers except GT_ThinkRules (dev builds)
set we_debug "0"

// SteamID64 operators (comma-separated; spaces/tabs OK).
// Same privileges as engine: op <password>
// Always on when we_enabled is 1 (no we_feature_* gate).
// set we_operators "76561198019045610,76561198020334905"
set we_operators ""

// Feature toggles (player/users + we_operators are always on when we_enabled is 1)
set we_feature_ban "1"
set we_feature_weapon "1"
set we_feature_respawn "1"
set we_feature_changeteam "1"
set we_feature_awards "1"
set we_awards_center_message "1"
set we_awards_chat_message "1"
set we_feature_report "1"
set we_feature_welcome "1"

// [WE] <name> is an operator — on enterGame for operators
set we_feature_opannounce "1"

// Scoreboard clan override (default off until tag/reserved are set)
// Operators: we_clan_tag (put ^ color codes in the tag, e.g. ^1Kandru)
// Non-ops matching we_clan_reserved (color-stripped, case-insensitive): "-"
set we_feature_clan "0"
// set we_clan_tag "^1Kandru"
// set we_clan_reserved "kandru"
set we_clan_tag ""
set we_clan_reserved ""

// Consecutive in-game name changes → warn player, then ban+kick ("name change spam")
set we_feature_nickban "0"
